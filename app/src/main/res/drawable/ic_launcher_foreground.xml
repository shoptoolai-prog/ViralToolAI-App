<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Radial Ambient Violet Glow -->
    <path
        android:pathData="M 0,0 H 108 V 108 H 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="48"
                android:type="radial">
                <item android:color="#45C084FC" android:offset="0.0" />
                <item android:color="#208B5CF6" android:offset="0.5" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek "V" Left Wing -->
    <path
        android:pathData="M 26,28 L 41,28 L 54,78 L 39,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="28"
                android:endX="54"
                android:endY="78"
                android:type="linear">
                <item android:color="#FFC084FC" android:offset="0.0" />
                <item android:color="#FF8B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek "V" Right Wing -->
    <path
        android:pathData="M 54,78 L 67,28 L 82,28 L 62,85 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="78"
                android:endX="82"
                android:endY="28"
                android:type="linear">
                <item android:color="#FF8B5CF6" android:offset="0.0" />
                <item android:color="#FFA78BFA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upward Growth Arrowhead Cap -->
    <path
        android:pathData="M 66,18 L 84,18 L 84,36 Z"
        android:fillColor="#FFA78BFA"/>

    <!-- Central AI Quantum Sparkle (White 4-point Diamond) -->
    <path
        android:pathData="M 54,34 Q 54,45 65,45 Q 54,45 54,56 Q 54,45 43,45 Q 54,45 54,34 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Sparkle Inner Violet Glow -->
    <path
        android:pathData="M 54,38 Q 54,45 61,45 Q 54,45 54,52 Q 54,45 47,45 Q 54,45 54,38 Z"
        android:fillColor="#FFC084FC"/>

    <!-- Connection Points -->
    <path
        android:pathData="M 26,28 C 26,28 26,28 26,28 M 84,18 C 84,18 84,18 84,18 M 54,85 C 54,85 54,85 54,85"
        android:strokeWidth="4.5"
        android:strokeColor="#FFC084FC"
        android:strokeLineCap="round"/>

</vector>
