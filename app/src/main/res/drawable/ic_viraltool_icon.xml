<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Ambient Violet Core Radial Halo Glow -->
    <path
        android:pathData="M 0,0 H 120 V 120 H 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="60"
                android:centerY="60"
                android:gradientRadius="55"
                android:type="radial">
                <item android:color="#508B5CF6" android:offset="0.0" />
                <item android:color="#20C084FC" android:offset="0.5" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Quantum Orbit Ring -->
    <path
        android:pathData="M 60,20 C 82,20 98,38 98,60 C 98,82 82,100 60,100 C 38,100 22,82 22,60 C 22,38 38,20 60,20 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#358B5CF6"/>

    <!-- Left Wing of "V" (Violet Gradient Data Stream) -->
    <path
        android:pathData="M 30,34 L 46,34 L 60,88 L 44,88 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="34"
                android:endX="60"
                android:endY="88"
                android:type="linear">
                <item android:color="#FFC084FC" android:offset="0.0" />
                <item android:color="#FF8B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Wing of "V" (Upward Momentum Arrow in Violet & Soft Purple) -->
    <path
        android:pathData="M 60,88 L 74,34 L 90,34 L 68,96 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="60"
                android:startY="88"
                android:endX="90"
                android:endY="34"
                android:type="linear">
                <item android:color="#FF8B5CF6" android:offset="0.0" />
                <item android:color="#FFA78BFA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upward Growth Arrowhead Cap on Right Wing -->
    <path
        android:pathData="M 72,24 L 92,24 L 92,44 Z"
        android:fillColor="#FFA78BFA"/>

    <!-- Central AI Quantum Core Sparkle (White 4-point Diamond Spark) -->
    <path
        android:pathData="M 60,40 Q 60,52 72,52 Q 60,52 60,64 Q 60,52 48,52 Q 60,52 60,40 Z"
        android:fillColor="#FFFFFF"/>

    <!-- AI Sparkle Inner Glow -->
    <path
        android:pathData="M 60,44 Q 60,52 68,52 Q 60,52 60,60 Q 60,52 52,52 Q 60,52 60,44 Z"
        android:fillColor="#FFC084FC"/>

    <!-- Neural Connection Nodes -->
    <path
        android:pathData="M 30,34 C 30,34 30,34 30,34 M 92,24 C 92,24 92,24 92,24 M 60,96 C 60,96 60,96 60,96"
        android:strokeWidth="5"
        android:strokeColor="#FFC084FC"
        android:strokeLineCap="round"/>

</vector>
